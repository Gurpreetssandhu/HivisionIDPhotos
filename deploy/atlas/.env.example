# HivisionIDPhotos - atlas deployment
#
# Copy to `.env` in this directory and fill in the real values:
#     cp .env.example .env
#
# `.env` is gitignored and must stay that way. This file contains placeholders
# only - never commit real values here.
#
# This file is also read by the systemd unit via EnvironmentFile=, so keep it
# to plain KEY=value lines. Do not quote values and do not put comments on the
# same line as a value; systemd does not parse either the way a shell does.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# atlas's Tailscale IPv4 address. Get the real value with:
#     tailscale ip -4
#
# This is the ONLY thing preventing the service from being exposed on the LAN.
# It must be a literal Tailscale address (100.64.0.0/10). Never 0.0.0.0, never
# blank, never a LAN address. Compose refuses to start if it is unset.
#
# If the address ever changes (it only changes if the node is removed from the
# tailnet and re-added), update this one line and run:
#     docker compose up -d
TAILSCALE_IP=100.100.100.100

# Host-side port. 7860 is the upstream Gradio default.
# Check nothing else claims it first: ss -tln | grep 7860
HOST_PORT=7860

# ---------------------------------------------------------------------------
# Host paths
# ---------------------------------------------------------------------------

# Absolute path to the data directory holding model weights and the size-preset
# CSV. Deliberately OUTSIDE the git working tree: the weights are ~450MB of
# binaries that must never be committed.
#
# Expected layout:
#   $DATA_DIR/weights/*.onnx                     matting models
#   $DATA_DIR/weights/retinaface/*.onnx          face detection model
#   $DATA_DIR/config/size_list_EN.csv            size presets
DATA_DIR=/path/to/hivision/data

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# UI language, read by demo/ui.py:31. One of: en, zh, ja, ko.
# Anything else silently falls back to zh.
DEFAULT_LANG=en

# Inference mode. The ONLY value the code recognises is `beast`, which keeps
# the matting and face-detection models resident in RAM between requests
# (faster on repeat use, more memory). Leave blank for normal mode, where
# models are freed after each request.
#
# Upstream recommends 16GB+ before enabling beast. If you do enable it, also
# raise `mem_limit` in docker-compose.yml from 4g to about 8g.
RUN_MODE=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
#
# This stack currently requires NO secrets. Nothing here is sensitive, and no
# secret material exists on atlas for this service.
#
# The only optional secrets upstream supports are the Face++ online face
# detection credentials (FACE_PLUS_API_KEY / FACE_PLUS_API_SECRET). They are
# deliberately NOT configured: Face++ uploads every photo to Megvii's API, and
# the offline RetinaFace model is used instead.
#
# See "Adding secrets later (Infisical)" in README.md if that ever changes.
